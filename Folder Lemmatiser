if (!requireNamespace("tcltk", quietly = TRUE)) {
    stop("tcltk is not available in this R build. Reinstall R with Tcl/Tk support.")
}
if (!requireNamespace("reticulate", quietly = TRUE)) install.packages("reticulate")

library(tcltk)
library(reticulate)

ENV_NAME <- "odycy_env_v3"

setup_odycy <- function() {
    if (!(ENV_NAME %in% virtualenv_list())) {
        py_path <- virtualenv_starter("3.11")
        if (is.null(py_path)) {
            message("No Python 3.11 found. Installing one via reticulate::install_python()...")
            install_python(version = "3.11:latest")
            py_path <- virtualenv_starter("3.11")
        }
        if (is.null(py_path)) {
            stop("Could not locate or install a Python 3.11 interpreter.")
        }
        message(paste("\nCreating virtual environment:", ENV_NAME))
        virtualenv_create(ENV_NAME, python = py_path)
    }
    
    use_virtualenv(ENV_NAME, required = TRUE)
    python_exe <- virtualenv_python(ENV_NAME)
    
    check_script <- file.path(tempdir(), "check_odycy.py")
    writeLines(
        c(
            "import sys",
            "try:",
            "    import spacy",
            "    spacy.load('grc_odycy_joint_sm')",
            "except Exception as e:",
            "    print(str(e), file=sys.stderr)",
            "    sys.exit(1)",
            "sys.exit(0)"
        ),
        check_script
    )
    
    check <- system2(python_exe, args = shQuote(check_script), stdout = FALSE, stderr = FALSE)
    
    if (check != 0) {
        message("\n[1/3] Updating build tools (pip, setuptools, wheel)...")
        system2(python_exe, args = c("-m", "pip", "install", "--upgrade", "--no-cache-dir",
                                     "pip", "setuptools", "wheel"))
        
        message("\n[2/3] Installing spaCy and click...")
        system2(python_exe, args = c("-m", "pip", "install", "--no-cache-dir",
                                     "click", shQuote("spacy>=3.7.4,<3.8.0")))
        
        message("\n[3/3] Installing OdyCy model (downloading wheel from Hugging Face)...")
        wheel_url <- "https://huggingface.co/chcaa/grc_odycy_joint_sm/resolve/main/grc_odycy_joint_sm-any-py3-none-any.whl"
        local_wheel <- file.path(tempdir(), "grc_odycy_joint_sm-1.0.0-py3-none-any.whl")
        
        download.file(wheel_url, destfile = local_wheel, mode = "wb")
        
        pip_res <- system2(python_exe, args = c("-m", "pip", "install", "--no-cache-dir",
                                                "--force-reinstall", shQuote(local_wheel)))
        if (pip_res != 0) {
            stop("Failed to install the OdyCy model wheel.")
        }
        
        recheck <- system2(python_exe, args = shQuote(check_script), stdout = FALSE, stderr = FALSE)
        if (recheck != 0) {
            stop("OdyCy model still fails to load after installation. Run the check script manually to see the error:\n",
                 python_exe, " ", check_script)
        }
        message("\nOdyCy model is installed and functioning correctly.")
    } else {
        message("OdyCy environment already set up and working.")
    }
    
    python_exe
}

run_odycy_lemmatizer <- function(input_folder) {
    python_exe <- setup_odycy()
    
    message("\nGenerating Python OdyCy lemmatization script...")
    py_script_path <- file.path(tempdir(), "odycy_lemmatizer_standalone.py")
    
    py_lines <- c(
        "import os",
        "import glob",
        "import spacy",
        "",
        sprintf('INPUT_DIR = r"""%s"""', input_folder),
        "",
        "nlp = spacy.load('grc_odycy_joint_sm', disable=['ner', 'parser'])",
        "nlp.max_length = 2000000",
        "",
        "def process_file(file_path):",
        "    try:",
        "        file_name = os.path.basename(file_path)",
        "        name, ext = os.path.splitext(file_name)",
        "        out_path = os.path.join(INPUT_DIR, name + '_Lemmatized' + ext)",
        "",
        "        if os.path.exists(out_path):",
        "            return True",
        "",
        "        with open(file_path, 'r', encoding='utf-8') as f:",
        "            text = f.read()",
        "",
        "        if not text.strip():",
        "            with open(out_path, 'w', encoding='utf-8') as f:",
        "                f.write('')",
        "            return True",
        "",
        "        doc = nlp(text)",
        "        lemmas = []",
        "        for token in doc:",
        "            lemma = token.lemma_ if token.lemma_ and token.lemma_ not in ['_', '-'] else token.text",
        "            lemmas.append(lemma)",
        "",
        "        with open(out_path, 'w', encoding='utf-8') as f:",
        "            f.write(' '.join(lemmas))",
        "        return True",
        "",
        "    except Exception as e:",
        "        print(f'Error processing {file_path}: {e}')",
        "        return False",
        "",
        "def main():",
        "    all_files = glob.glob(os.path.join(INPUT_DIR, '*.txt'))",
        "    files = [f for f in all_files if not f.endswith('_Lemmatized.txt')]",
        "",
        "    if not files:",
        "        print('No new .txt files found to process in the selected folder.')",
        "        return",
        "",
        "    print(f'Found {len(files)} files to process.')",
        "",
        "    for i, fp in enumerate(files, 1):",
        "        ok = process_file(fp)",
        "        status = 'OK' if ok else 'FAILED'",
        "        print(f'[{i}/{len(files)}] {status}: {os.path.basename(fp)}')",
        "",
        "    print('Processing complete.')",
        "",
        "if __name__ == '__main__':",
        "    main()"
    )
    
    writeLines(py_lines, py_script_path)
    
    message("\n--- Starting OdyCy Processing ---")
    system2(python_exe, args = shQuote(py_script_path))
    message("--- Process Ended ---\n")
}

process_folder <- function() {
    folder_path <- tclvalue(tkchooseDirectory(title = "Select folder containing Greek .txt files"))
    
    if (folder_path == "") {
        message("No folder selected. Exiting.")
        return(invisible(NULL))
    }
    
    message(paste("Folder selected:", folder_path))
    run_odycy_lemmatizer(folder_path)
}

# ---- RUN ----
process_folder()
