# Check and install required packages
required_packages <- c("readr", "dplyr", "writexl", "stringi", "ggplot2", "tcltk", "tools")
new_packages <- required_packages[!(required_packages %in% installed.packages()[,"Package"])]
if(length(new_packages)) install.packages(new_packages)

# Load required libraries
library(readr)
library(dplyr)
library(writexl)
library(stringi)
library(ggplot2)
library(tcltk)
library(utils) # עבור חלון בחירת הקבצים

main <- function() {
  # 1. בחירת תיקיית מקור
  input_folder <- tclvalue(tkchooseDirectory(title = "Select folder containing text files"))
  
  if (nchar(input_folder) == 0) {
    cat("No folder selected. Exiting program.\n")
    return()
  }
  
  txt_files <- list.files(input_folder, pattern = "\\.txt$", full.names = TRUE)
  
  if (length(txt_files) == 0) {
    cat("No text files found. Exiting program.\n")
    return()
  }
  
  # ---------------------------------------------------------
  # 2. שלב חדש: חלון גרפי לסינון קבצים
  # ---------------------------------------------------------
  file_names <- basename(txt_files)
  
  cat("Opening file selection window...\n")
  
  # פתיחת חלון הבחירה - כל הקבצים מסומנים (preselect) כברירת מחדל
  selected_file_names <- select.list(
    choices = file_names,
    preselect = file_names,
    multiple = TRUE,
    title = "Select files to analyze (Click to unselect)",
    graphics = TRUE
  )
  
  # אם המשתמש ביטל את כולם או סגר את החלון (ביטול הפעולה)
  if (length(selected_file_names) == 0) {
    cat("No files selected or window closed. Exiting program.\n")
    return()
  }
  
  # סינון רשימת הנתיבים המקורית רק לקבצים שהמשתמש השאיר מסומנים
  txt_files <- txt_files[file_names %in% selected_file_names]
  # ---------------------------------------------------------
  
  cat("Processing", length(txt_files), "selected files efficiently...\n")
  
  # 3. ספירת טוקנים מהירה באמצעות stringi
  token_counts <- sapply(txt_files, function(file_path) {
    text <- read_file(file_path)
    sum(stri_count_words(text)) 
  })
  
  # 4. יצירת מסד הנתונים
  results_df <- data.frame(
    File_Name = tools::file_path_sans_ext(basename(txt_files)),
    Tokens = unname(token_counts)
  )
  
  # מיון הקבצים מהגדול לקטן
  results_df <- results_df %>% arrange(desc(Tokens))
  
  # חישוב סך כל הטוקנים בקורפוס המסונן
  total_tokens <- sum(results_df$Tokens)
  
  # 5. יצירת הגרף
  p <- ggplot(results_df, aes(x = reorder(File_Name, Tokens), y = Tokens)) +
    geom_col(fill = "steelblue") +
    coord_flip() + 
    theme_minimal() +
    labs(
      title = "מספר טוקנים לפי קובץ",
      subtitle = paste("סך הכל טוקנים בקורפוס הנבחר:", format(total_tokens, big.mark = ",")),
      x = "שם הקובץ",
      y = "מספר טוקנים"
    )
  
  print(p)
  
  # 6. בחירת מיקום לשמירת התוצאות
  cat("Please select a folder to save the output Excel and Plot.\n")
  output_folder <- tclvalue(tkchooseDirectory(title = "Select folder to save results"))
  
  if (nchar(output_folder) == 0) {
    cat("No save location selected. Outputs generated but not saved to disk.\n")
    return()
  }
  
  # 7. ייצוא לאקסל ולתמונה
  excel_path <- file.path(output_folder, "Corpus_Token_Counts.xlsx")
  plot_path <- file.path(output_folder, "Corpus_Token_Plot.png")
  
  summary_row <- data.frame(File_Name = "TOTAL_CORPUS_TOKENS", Tokens = total_tokens)
  excel_df <- bind_rows(results_df, summary_row)
  
  write_xlsx(excel_df, excel_path)
  ggsave(plot_path, plot = p, width = 10, height = 8, dpi = 300)
  
  cat("Done! Total tokens calculated:", format(total_tokens, big.mark = ","), "\n")
  cat("Results saved to:", output_folder, "\n")
}

# הפעלת התוכנית
main()
