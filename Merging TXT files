      fileInput("files", NULL, 
                multiple = TRUE, 
                accept = c(".txt", "text/plain"),
                buttonLabel = "Browse...",
                placeholder = "No files selected")
    ),
    
    # Show selected files list
    uiOutput("file_list"),
    
