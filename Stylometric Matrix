server <- function(input, output, session) {
  
  analysis_data   <- reactiveVal(NULL)
  advanced_shown  <- reactiveVal(FALSE)
  corpus_dir      <- reactiveVal(NULL)
  
  log_msg <- function(msg, level = "info") {
    ts <- format(Sys.time(), "%H:%M:%S")
    session$sendCustomMessage("appendLog", list(text = paste0("[", ts, "] ", msg), level = level))
    cat(sprintf("[%s] %s\n", ts, msg))
    flush.console()
  }
  
  observeEvent(input$show_advanced, { advanced_shown(TRUE) })
  
  observeEvent(input$reset, {
    reset("files")
    analysis_data(NULL)
    advanced_shown(FALSE)
    old_dir <- isolate(corpus_dir())
    if (!is.null(old_dir) && dir.exists(old_dir)) unlink(old_dir, recursive = TRUE)
    corpus_dir(NULL)
    session$sendCustomMessage("clearLog", list())
  })
  
  observeEvent(input$files, {
    analysis_data(NULL)
    advanced_shown(FALSE)
  })
  
  run_stylo <- function(mfw_value, use_stopwords, distance_key) {
    
    withProgress(message = 'Running stylo()...', value = 0, {
      
      log_msg(sprintf("Starting run: %d files, MFW=%d, stopwords=%s, method=%s",
                       nrow(input$files), mfw_value, use_stopwords, distance_key))
      incProgress(0.05, detail = "Reading uploaded files...")
      
      work_dir <- file.path(tempdir(), basename(tempfile(pattern = "stylo_run_")))
      dir.create(work_dir, recursive = TRUE, showWarnings = FALSE)
      cdir <- file.path(work_dir, "corpus")
      dir.create(cdir, showWarnings = FALSE)
      
      t_step <- Sys.time()
      raw_texts <- vapply(
        input$files$datapath,
        function(p) paste(readLines(p, encoding = "UTF-8", warn = FALSE), collapse = "\n"),
        character(1)
      )
      log_msg(sprintf("Read %d files in %.2f sec (total %s chars)",
                       length(raw_texts), as.numeric(Sys.time() - t_step, units = "secs"),
                       format(sum(nchar(raw_texts)), big.mark = ",")))
      
      incProgress(0.15, detail = "Lowercasing (stringi, ICU)...")
      t_step <- Sys.time()
      raw_texts <- greek_tolower(raw_texts)
      log_msg(sprintf("Lowercased in %.2f sec", as.numeric(Sys.time() - t_step, units = "secs")))
      
      incProgress(0.25, detail = "Stripping Greek accents (stringi, ICU)...")
      t_step <- Sys.time()
      raw_texts <- strip_greek_accents(raw_texts)
      log_msg(sprintf("Accent-stripped in %.2f sec", as.numeric(Sys.time() - t_step, units = "secs")))
      
      incProgress(0.3, detail = "Writing normalized corpus to disk...")
      t_step <- Sys.time()
      for (i in seq_along(raw_texts)) {
        writeLines(raw_texts[i], file.path(cdir, input$files$name[i]), useBytes = TRUE)
      }
      log_msg(sprintf("Wrote %d files in %.2f sec", length(raw_texts),
                       as.numeric(Sys.time() - t_step, units = "secs")))
      
      old_dir <- corpus_dir()
      if (!is.null(old_dir) && dir.exists(old_dir)) unlink(old_dir, recursive = TRUE)
      corpus_dir(work_dir)
      
      incProgress(0.4, detail = "Running native stylo pipeline...")
      log_msg("Calling stylo() now...")
      
      old_wd <- getwd()
      setwd(work_dir)
      on.exit(setwd(old_wd), add = TRUE)
      
      stopword_vec <- if (use_stopwords) greek_stopwords else NULL
      
      t_step <- Sys.time()
      result <- tryCatch({
        stylo(
          gui = FALSE,
          corpus.dir = "corpus",
          corpus.lang = "Other",
          analysis.type = "CA",
          mfw.min = mfw_value,
          mfw.max = mfw_value,
          mfw.incr = 100,
          culling.min = 0,
          culling.max = 0,
          distance.measure = stylo_distance_map[[distance_key]],
          stop.words = stopword_vec,
          display.on.screen = FALSE,
          write.pdf.file = FALSE,
          write.png.file = FALSE,
          write.jpg.file = FALSE,
          write.svg.file = FALSE,
          save.distance.tables = TRUE
        )
      }, error = function(e) {
        log_msg(paste("stylo() ERROR:", conditionMessage(e)), level = "error")
        showNotification(paste("Stylo Engine Error:", conditionMessage(e)), type = "error", duration = 10)
        stop(e)
      })
      log_msg(sprintf("stylo() finished in %.2f sec", as.numeric(Sys.time() - t_step, units = "secs")))
      
      incProgress(0.85, detail = "Reading stylo's distance table CSV...")
      
      csv_candidates <- list.files(work_dir, pattern = "^distance_table.*\\.csv$",
                                    full.names = TRUE, recursive = TRUE)
      log_msg(sprintf("Found %d distance_table CSV candidate(s)", length(csv_candidates)))
      
      if (length(csv_candidates) > 0) {
        dist_df <- read.csv(csv_candidates[1], row.names = 1, check.names = FALSE)
        dist_matrix <- as.matrix(dist_df)
      } else {
        dist_matrix <- as.matrix(result$distance.table)
      }
      
      original_names <- input$files$name
      names(original_names) <- tools::file_path_sans_ext(input$files$name)
      
      match_original <- function(x) {
        stripped <- tools::file_path_sans_ext(x)
        ifelse(stripped %in% names(original_names), original_names[stripped], x)
      }
      rownames(dist_matrix) <- match_original(rownames(dist_matrix))
      colnames(dist_matrix) <- match_original(colnames(dist_matrix))
      
      sorted_names <- sort(rownames(dist_matrix))
      dist_matrix <- dist_matrix[sorted_names, sorted_names]
      
      incProgress(1.0, detail = "Completed!")
      log_msg("Done - rendering heatmap.")
      
      list(
        dist_matrix = dist_matrix,
        file_names  = sorted_names,
        mfw         = mfw_value,
        stopwords_used = use_stopwords
      )
    })
  }
  
  observeEvent(input$analyze, {
    req(input$files)
    if (nrow(input$files) < 2) {
      showNotification("At least 2 files are required for analysis", type = "error")
      return()
    }
    
    res <- run_stylo(mfw_value = 100, use_stopwords = FALSE,
                      distance_key = input$distance_method)
    
    analysis_data(list(
      dist_matrix = res$dist_matrix,
      file_names  = res$file_names,
      method      = input$distance_method,
      color_scheme = input$color_scheme,
      mfw = res$mfw,
      stopwords_used = res$stopwords_used
    ))
  })
  
  output$advanced_ui <- renderUI({
    req(advanced_shown())
    div(class = "advanced-container",
      h3("Advanced Options"),
      div(class = "param-box",
        sliderInput("mfw_adv",
                    "Number of Most Frequent Words (MFW):",
                    min = 10, max = 200, value = 100, step = 10),
        div(class = "info-text", "Re-runs stylo() with this MFW cutoff")
      ),
      div(class = "param-box",
        checkboxInput("use_stopwords_adv", "Remove Greek stop words", value = TRUE),
        div(class = "info-text", "Corpus is accent-folded first, so the (unaccented) stop-word list matches correctly")
      ),
      actionButton("refine", "Re-run stylo() with these settings", class = "btn-refine")
    )
  })
  
  observeEvent(input$refine, {
    req(input$files, analysis_data())
    
    res <- run_stylo(mfw_value = input$mfw_adv,
                      use_stopwords = input$use_stopwords_adv,
                      distance_key = input$distance_method)
    
    analysis_data(list(
      dist_matrix = res$dist_matrix,
      file_names  = res$file_names,
      method      = input$distance_method,
      color_scheme = input$color_scheme,
      mfw = res$mfw,
      stopwords_used = res$stopwords_used
    ))
  })
  
  full_dims <- reactive({
    req(analysis_data())
    data <- analysis_data()
    n <- nrow(data$dist_matrix)
    max_name_len <- max(nchar(rownames(data$dist_matrix)))
    cell_px <- input$cell_size
    label_px <- input$label_size
    
    matrix_side <- n * cell_px
    label_margin <- max_name_len * label_px * 0.62 + 60
    
    list(
      width  = matrix_side + label_margin + 40,
      height = matrix_side + label_margin + 40
    )
  })
  
  output$results_ui <- renderUI({
    req(analysis_data())
    data <- analysis_data()
    
    div(class = "results-container",
      h3("Analysis Results"),
      div(class = "info-text", style = "text-align:center;",
          paste0("MFW = ", data$mfw, " | Stop words removed: ",
                 ifelse(data$stopwords_used, "Yes", "No"),
                 " | Method: ", distance_labels[[data$method]])),
      div(class = "preview-container",
        imageOutput("heatmap_plot", width = "100%", height = "auto")
      ),
      div(class = "info-text", style = "text-align:center; margin-top:8px;",
          "Preview is scaled for visibility. Downloaded files retain full resolution and size settings."),
      hr(),
      downloadButton("download_matrix", "Download Matrix (CSV)", style = "margin: 10px 5px;"),
      downloadButton("download_plot", "Download Heatmap (PNG, 300 DPI)", style = "margin: 10px 5px;"),
      downloadButton("download_svg", "Download Heatmap (SVG)", style = "margin: 10px 5px;")
    )
  })
  
  make_palette_fn <- function(scheme) {
    switch(scheme,
      "purple_yellow" = colorRampPalette(c("#9B59B6", "#F39C12")),
      "blue_red" = colorRampPalette(c("#3498DB", "#E74C3C")),
      "green_orange" = colorRampPalette(c("#27AE60", "#E67E22")),
      "cyan_pink" = colorRampPalette(c("#16A085", "#E91E63"))
    )
  }
  
  # ---- Back to plain linear color mapping (previous version) - only the
  # axis-label alignment fix is kept: axis.ticks.length.y = 0 and tight
  # margins pull the row names flush against the left edge of the matrix. --
  draw_heatmap <- function(dist_mat, scheme, method_key, label_pt) {
    nm <- rownames(dist_mat)
    df <- reshape2::melt(dist_mat, varnames = c("Row", "Col"), value.name = "Distance")
    df$Row <- factor(df$Row, levels = nm)
    df$Col <- factor(df$Col, levels = nm)
    
    pal_fn <- make_palette_fn(scheme)
    
    ggplot(df, aes(x = Col, y = Row, fill = Distance)) +
      geom_tile(color = NA) +
      scale_fill_gradientn(colors = pal_fn(100)) +
      coord_fixed() +
      labs(title = paste("Heatmap - Stylometric Distances | Method:", distance_labels[[method_key]]),
           x = NULL, y = NULL, fill = "Distance") +
      theme_minimal(base_size = label_pt + 2) +
      theme(
        axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5, size = label_pt),
        axis.text.y = element_text(size = label_pt, hjust = 1, margin = margin(r = 2)),
        axis.ticks.length.y = unit(0, "pt"),
        axis.ticks.length.x = unit(0, "pt"),
        plot.title = element_text(hjust = 0.5, face = "bold"),
        plot.margin = margin(t = 10, r = 10, b = 5, l = 5),
        panel.grid = element_blank()
      ) +
      scale_y_discrete(position = "left", expand = c(0, 0)) +
      scale_x_discrete(position = "bottom", expand = c(0, 0))
  }
  
  output$heatmap_plot <- renderImage({
    req(analysis_data())
    data <- analysis_data()
    dims <- full_dims()
    
    outfile <- tempfile(fileext = ".svg")
    p <- draw_heatmap(data$dist_matrix, data$color_scheme, data$method, input$label_size)
    
    ggsave(outfile, plot = p,
           width = max(dims$width / 96, 4), height = max(dims$height / 96, 4),
           units = "in", device = "svg", limitsize = FALSE, bg = "white")
    
    list(src = outfile,
         contentType = "image/svg+xml",
         width = "100%",
         style = "max-width: 100%; height: auto; max-height: 730px; object-fit: contain; display: block; margin: 0 auto;",
         alt = "Heatmap Preview")
  }, deleteFile = TRUE)
  
  output$download_matrix <- downloadHandler(
    filename = function() paste0("distance_matrix_", Sys.Date(), ".csv"),
    content = function(file) {
      data <- analysis_data()
      write.csv(data$dist_matrix, file, fileEncoding = "UTF-8", row.names = TRUE)
    }
  )
  
  output$download_plot <- downloadHandler(
    filename = function() paste0("heatmap_", Sys.Date(), ".png"),
    content = function(file) {
      tryCatch({
        data <- analysis_data()
        dims <- full_dims()
        p <- draw_heatmap(data$dist_matrix, data$color_scheme, data$method, input$label_size)
        ggsave(file, plot = p,
               width = max(dims$width / 96, 4), height = max(dims$height / 96, 4),
               dpi = 300, units = "in", limitsize = FALSE, bg = "white")
      }, error = function(e) {
        showNotification(paste("PNG export failed:", conditionMessage(e)), type = "error", duration = 10)
        stop(e)
      })
    }
  )
  
  output$download_svg <- downloadHandler(
    filename = function() paste0("heatmap_", Sys.Date(), ".svg"),
    content = function(file) {
      tryCatch({
        data <- analysis_data()
        dims <- full_dims()
        p <- draw_heatmap(data$dist_matrix, data$color_scheme, data$method, input$label_size)
        ggsave(file, plot = p,
               width = max(dims$width / 96, 4), height = max(dims$height / 96, 4),
               units = "in", device = "svg", limitsize = FALSE, bg = "white")
      }, error = function(e) {
        showNotification(paste("SVG export failed:", conditionMessage(e)), type = "error", duration = 10)
        stop(e)
      })
    }
  )
  
  session$onSessionEnded(function() {
    d <- isolate(corpus_dir())
    if (!is.null(d) && dir.exists(d)) unlink(d, recursive = TRUE)
  })
}

ui <- tagList(
  tags$head(tags$script(HTML("
    Shiny.addCustomMessageHandler('appendLog', function(msg) {
      var el = document.getElementById('log_console');
      if (!el) return;
      var line = document.createElement('div');
      if (msg.level === 'error') line.className = 'log-error';
      if (msg.level === 'warn') line.className = 'log-warn';
      line.textContent = msg.text;
      el.appendChild(line);
      el.scrollTop = el.scrollHeight;
    });
    Shiny.addCustomMessageHandler('clearLog', function(msg) {
      var el = document.getElementById('log_console');
      if (el) el.innerHTML = '';
    });
  "))),
  ui
)

shinyApp(ui = ui, server = server)
