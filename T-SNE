# Load required libraries
library(tcltk)
library(stylo)
library(ggplot2)
library(Rtsne)
library(svglite)
library(ggrepel)

progress_msg <- function(msg) {
  cat(paste0("[", format(Sys.time(), "%H:%M:%S"), "] ", msg, "\n"))
  flush.console()
}

progress_msg("Starting clean t-SNE analysis...")

# 1. Select working folder (must contain a 'corpus' subfolder, STYLO-style)
folder_path <- tk_choose.dir(caption = "Select WORKING folder (must contain a 'corpus' subfolder)")
if (is.na(folder_path) || !nzchar(folder_path)) stop("No folder selected")

# If the user selected the 'corpus' folder itself, go up one level
if (tolower(basename(folder_path)) == "corpus") {
  folder_path <- dirname(folder_path)
  progress_msg("Selected folder was 'corpus' itself - using its parent as working folder.")
}

setwd(folder_path)

corpus_dir_path <- file.path(folder_path, "corpus")
if (!dir.exists(corpus_dir_path)) {
  stop("No 'corpus' subfolder found in: ", folder_path,
       "\nCreate a folder named 'corpus' there and put the .txt files inside it.")
}

output_dir <- file.path(folder_path, "output_results")
if (!dir.exists(output_dir)) dir.create(output_dir)

progress_msg(paste("Working folder:", folder_path))
progress_msg(paste("Corpus folder: ", corpus_dir_path))
progress_msg(paste("Output folder: ", output_dir))

# ============================================
# 2. Load texts and strip all punctuation
# ============================================
progress_msg("Reading text files and stripping all punctuation...")

txt_files <- list.files(corpus_dir_path, pattern = "\\.txt$", full.names = TRUE)

if (length(txt_files) < 4) stop("Not enough .txt files found in: ", corpus_dir_path)

use_stringi <- requireNamespace("stringi", quietly = TRUE)

tokenized_corpus <- list()

for (i in seq_along(txt_files)) {
  f <- txt_files[i]
  doc_name <- sub("\\.txt$", "", basename(f))
  progress_msg(sprintf("(%d/%d) %s [%.1f MB]", i, length(txt_files),
                       basename(f), file.size(f) / 1e6))

  lines <- readLines(f, encoding = "UTF-8", warn = FALSE)
  lines <- enc2utf8(lines)

  if (use_stringi) {
    lines <- stringi::stri_trans_tolower(lines)
    lines <- stringi::stri_replace_all_regex(lines, "[^\\p{L}\\p{M}]+", " ")
  } else {
    lines <- tolower(lines)
    lines <- gsub("[^\\p{L}\\p{M}]+", " ", lines, perl = TRUE)
  }

  words <- unlist(strsplit(lines, " ", fixed = TRUE), use.names = FALSE)
  words <- words[nzchar(words)]

  tokenized_corpus[[doc_name]] <- words
}

progress_msg(paste("Successfully tokenized", length(tokenized_corpus), "documents."))

progress_msg("Building frequency list (top 5000)...")
frequent_features <- make.frequency.list(tokenized_corpus, head = 5000)
word_frequencies  <- make.table.of.frequencies(tokenized_corpus, features = frequent_features, relative = TRUE)

file_labels <- rownames(word_frequencies)
progress_msg(paste("Frequency table ready:", nrow(word_frequencies), "docs x", ncol(word_frequencies), "words."))

# ============================================
# 3. t-SNE
# ============================================
n_docs <- nrow(word_frequencies)
perplexity_val <- min(10, floor((n_docs - 2) / 3))
if (perplexity_val < 1) stop("Too few documents for t-SNE.")
progress_msg(paste("Running t-SNE with perplexity", perplexity_val))

set.seed(42)
tsne_result <- Rtsne(
  as.matrix(word_frequencies),
  dims = 2,
  perplexity = perplexity_val,
  verbose = TRUE,
  max_iter = 1000,
  theta = 0.5,
  check_duplicates = FALSE,
  num_threads = 0
)
progress_msg("t-SNE finished.")

# ============================================
# 4. Shorten labels
# ============================================
clean_labels <- file_labels
clean_labels <- sub("_SC_tlg[0-9]+\\.tlg[0-9]+.*$", "", clean_labels)
clean_labels <- sub("^Septuaginta_", "LXX_", clean_labels)
clean_labels <- sub("^New_Testament_", "NT_", clean_labels)
clean_labels <- sub("^NT_Gospel_of_([^_]+)_.*$", "NT_Gospel_of_\\1", clean_labels)
clean_labels <- sub("^(NT_[^_]+_[^_]+)_.*$", "\\1", clean_labels)
clean_labels <- sub("^Eusebius_of_Caesarea_", "Eusebius_", clean_labels)
clean_labels <- sub("^Flavius_Josephus_", "Josephus_", clean_labels)
clean_labels <- sub("^Philo_Judaeus_", "Philo_", clean_labels)
clean_labels <- sub("^Homeric_Hymns_", "Homeric_", clean_labels)

# ============================================
# 5. Rotation
# ============================================
rotation_angle_deg <- 110
flip_horizontal    <- FALSE
flip_vertical      <- FALSE

theta_rad <- rotation_angle_deg * pi / 180
raw_x <- tsne_result$Y[, 1]
raw_y <- tsne_result$Y[, 2]

rot_x <- raw_x * cos(theta_rad) - raw_y * sin(theta_rad)
rot_y <- raw_x * sin(theta_rad) + raw_y * cos(theta_rad)

if (flip_horizontal) rot_x <- -rot_x
if (flip_vertical)   rot_y <- -rot_y

tsne_df <- data.frame(
  X = rot_x,
  Y = rot_y,
  Full_Filename = file_labels,
  Label = clean_labels
)

# ============================================
# 6. Color groups
# ============================================
is_translated <- grepl("^(Septuaginta|Liber_Enoch|LXX_|Enoch)", file_labels) &
                 !grepl("Machabaeorum_(ii|iii|iv)|Maccabees_[234]", file_labels)

tsne_df$Group <- ifelse(is_translated, "Translated Works", "Original Greek")
group_colors <- c("Original Greek" = "#66c2a5", "Translated Works" = "#fc8d62")

# ============================================
# 7. Plot
# ============================================
progress_msg("Building plot...")
p <- ggplot(tsne_df, aes(x = X, y = Y, label = Label, color = Group)) +
  geom_point(size = 3.2, alpha = 0.9) +
  geom_text_repel(
    size = 3,
    box.padding = 0.15,
    point.padding = 0.15,
    segment.color = NA,
    max.overlaps = 50,
    max.iter = 3000,
    max.time = 2,
    seed = 42,
    show.legend = FALSE
  ) +
  scale_color_manual(values = group_colors) +
  scale_x_continuous(expand = expansion(mult = c(0.12, 0.18))) +
  scale_y_continuous(expand = expansion(mult = c(0.10, 0.10))) +
  labs(
    title = paste0("t-SNE of Word-Frequency Vectors (All ", ncol(word_frequencies), " Terms - No Punctuation)"),
    subtitle = paste("Raw Relative Frequencies | Perplexity:", perplexity_val, "| Rotated:", rotation_angle_deg, "°"),
    x = "t-SNE 1",
    y = "t-SNE 2",
    color = "Legend"
  ) +
  theme_minimal(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0),
    plot.subtitle = element_text(size = 10, color = "grey40"),
    plot.background = element_rect(fill = "white", color = NA),
    panel.background = element_rect(fill = "white", color = NA),
    panel.grid.major = element_line(color = "grey92"),
    panel.grid.minor = element_blank(),
    legend.position = "right",
    legend.title = element_text(face = "bold", size = 10)
  )

# ============================================
# 8. Save outputs (outside the corpus folder)
# ============================================
progress_msg("Saving CSV...")
csv_file <- file.path(output_dir, "tsne_no_punctuation.csv")
write.csv(tsne_df, csv_file, row.names = FALSE)

progress_msg("Saving SVG...")
output_svg <- file.path(output_dir, "tsne_no_punctuation.svg")
ggsave(output_svg, plot = p, width = 15, height = 9)

progress_msg("Saving PNG...")
output_png <- file.path(output_dir, "tsne_no_punctuation.png")
ggsave(output_png, plot = p, width = 15, height = 9, dpi = 300)

progress_msg("=== COMPLETE ===")
progress_msg(paste("SVG saved to:", output_svg))
